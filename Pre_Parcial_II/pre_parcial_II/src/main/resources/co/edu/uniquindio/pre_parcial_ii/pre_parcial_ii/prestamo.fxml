<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.pre_parcial_ii.pre_parcial_ii.viewcontroller.PrestamoViewController">
   <children>
      <Pane prefHeight="400.0" prefWidth="600.0">
         <children>
            <Button fx:id="btnVer1" layoutX="179.0" layoutY="35.0" mnemonicParsing="false" onAction="#AbrirObjetosMasPrestados" text="Ver" />
            <Label layoutX="41.0" layoutY="39.0" text="Objetos mas prestados" />
            <Label layoutX="41.0" layoutY="80.0" text="Objeto (Código):" />
            <TextField fx:id="txCodigoObjeto" layoutX="139.0" layoutY="76.0" text="Ingrese Codigo" />
            <Button fx:id="btnBuscar" layoutX="311.0" layoutY="76.0" mnemonicParsing="false" onAction="#BuscarObjetoPorCodigo" text="Buscar" />
            <Label layoutX="41.0" layoutY="143.0" text="Clientes  con mayor Prestamos" />
            <Button fx:id="btnVer2" layoutX="220.0" layoutY="139.0" mnemonicParsing="false" onAction="#AbrirClientesConMayorPrestamos" text="Ver" />
            <Label layoutX="41.0" layoutY="192.0" text="Objetos Disponibles" />
            <Label layoutX="38.0" layoutY="244.0" text="Objetos NO disponibles" />
            <Button fx:id="btnVer3" layoutX="162.0" layoutY="188.0" mnemonicParsing="false" onAction="#AbrirObjetosDisponibles" text="Ver" />
            <Button fx:id="btnVer4" layoutX="179.0" layoutY="240.0" mnemonicParsing="false" onAction="#AbrirObjetosNoDisponibles" text="Ver" />
         </children>
      </Pane>
   </children>
</AnchorPane>
